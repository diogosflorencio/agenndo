# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mercado Pago (app em developers.mercadopago.com.br)
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
# MP exige HTTPS - use produção ou túnel (ngrok). Não use http://localhost
MERCADOPAGO_REDIRECT_URI=https://www.agenndo.com.br/api/mercadopago/oauth/callback
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
# true só se no app MP estiver ligado "OAuth com PKCE" (senão authorization retorna 400)
MERCADOPAGO_OAUTH_USE_PKCE=false

# Criptografia tokens OAuth + state (string aleatória longa)
APP_ENCRYPTION_KEY=

# WhatsApp (infraestrutura; envio real via services/whatsapp-gateway na VPS)
WHATSAPP_PROVIDER=mock
WHATSAPP_GATEWAY_URL=http://localhost:4010
WHATSAPP_GATEWAY_API_KEY=
NEXT_PUBLIC_WHATSAPP_UI_MODE=dev

# Stripe (assinatura Agenndo)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
